# Copy to .env.local for development. On Vercel add these under Project → Settings → Environment Variables;
# on Cloudflare run `npx wrangler secret put <NAME>` for each.

# Password for /admin
ADMIN_PASSWORD=
# Long random string used to sign the login cookie, e.g. `openssl rand -base64 32`
SESSION_SECRET=

# Turso database (https://turso.tech). Leave unset locally to use a SQLite file (local.db).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Production domain, used for canonical URLs, sitemap.xml, robots.txt, social previews and structured data.
# Read at build time, so set it before building/deploying.
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional: ownership verification codes from Google Search Console and Bing Webmaster Tools (HTML tag method).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
