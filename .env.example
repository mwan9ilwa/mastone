# Copy to .env.local for development. On Vercel add these under Project → Settings → Environment Variables;
# on Cloudflare run `npx wrangler secret put <NAME>` for each.

# Password for /admin
ADMIN_PASSWORD=change-me
# Long random string used to sign the login cookie, e.g. `openssl rand -base64 32`
SESSION_SECRET=

# Turso database (https://turso.tech). Leave unset locally to use a SQLite file (local.db).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
